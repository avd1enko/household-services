{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=household_services_db"
  },
  "NotificationService": {
    "BaseUrl": "http://localhost:5333"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "COPY_ENTIRE_JWT_AND_WRITE_YOUR_OWN_KEY_IN_appsettings.Development.json",
    "Issuer": "HouseholdServices",
    "Audience": "HouseholdServicesClient",
    "ExpiresInMinutes": 60
  }
}
